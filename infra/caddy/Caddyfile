# Edge proxy for the whole platform.
#  - *.ROOT_DOMAIN and ROOT_DOMAIN: ONE wildcard certificate, obtained with the Cloudflare DNS challenge. Creating a store/clinic never touches TLS.
#  - Customers' own domains: certificates are issued on demand, but only after the backend confirms the host is a verified tenant domain.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:8080/internal/domains/allowed
	}
}

(app) {
	encode zstd gzip

	# Public product images/logos: served straight from the public bucket. Keys contain a content hash, so they are immutable.
	# Only GET/HEAD; the private (medical) bucket is never mapped here.
	@media {
		path /media/*
		method GET HEAD
	}
	handle @media {
		uri strip_prefix /media
		rewrite * /{$S3_PUBLIC_BUCKET}{uri}
		reverse_proxy minio:9000 {
			header_up Host minio:9000
			header_down -Set-Cookie
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# API goes straight to Spring Boot (webhooks, files, mobile apps). /internal/*, /actuator/* and API docs are deliberately NOT routed.
	# Browsers normally use /api/bff/* on the web app, which adds the session token server-side.
	@api path /api/v1/*
	handle @api {
		reverse_proxy backend:8080 {
			lb_policy least_conn
			health_uri /actuator/health
			health_interval 10s
		}
	}

	handle {
		reverse_proxy web:3000 {
			lb_policy least_conn
		}
	}
}

*.{$ROOT_DOMAIN}, {$ROOT_DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import app
}

https:// {
	tls {
		on_demand
	}
	import app
}
