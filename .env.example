# --- database ---
DB_NAME=platform
DB_USERNAME=platform
DB_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SECRET=

# --- tenancy / domains ---
# Root domain tenants get a free instant subdomain of: <slug>.<PLATFORM_ROOT_DOMAIN>
# DNS needed once: A record for PLATFORM_ROOT_DOMAIN and a wildcard A record *.PLATFORM_ROOT_DOMAIN -> this server.
PLATFORM_ROOT_DOMAIN=
# Hostname custom domains CNAME to (an A/CNAME record you create pointing at this server), e.g. edge.example.com
PLATFORM_EDGE_HOST=
# Contact e-mail for Let's Encrypt certificates (Caddy)
ACME_EMAIL=

# Comma-separated allowed browser origins, or leave default for same-site web
CORS_ALLOWED_ORIGINS=

# Leave empty in production
SPRING_PROFILES_ACTIVE=

# --- web (Next.js) ---
# Encrypts the web session cookie. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_SESSION_SECRET=
WEB_IMAGE_TAG=latest

# Signs payment-provider webhooks (the mock provider). Real gateways bring their own secret.
# openssl rand -hex 32
BILLING_WEBHOOK_SECRET=

# First platform owner (created at startup if none exists). Phone + a strong password (12+ chars).
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_PASSWORD=

# --- edge (Cloudflare) ---
# API token with Zone:DNS:Edit for the root domain's zone. Used by Caddy for the wildcard certificate (DNS challenge).
CF_API_TOKEN=

# --- object storage (S3-compatible) ---
# Choose long random values (openssl rand -hex 24). These are the storage root credentials.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BUCKET=public-media
S3_PRIVATE_BUCKET=private-medical
# Optional: images to use for the storage + client containers (see the note in docker-compose.yml)
MINIO_IMAGE=
MC_IMAGE=

# --- Redis (rate limits and caches shared by all backend instances) ---
REDIS_PASSWORD=

# --- shared server only (another site already owns ports 80/443) ---
# Leave unset on a dedicated server. See docs/DEPLOY.md.
# EDGE_HTTP_PORT=8081
# EDGE_HTTP_BIND=127.0.0.1
# EDGE_HTTPS_PORT=8443
# Cloudflare edge ranges (https://www.cloudflare.com/ips/ - verify before use), space separated. Needed when the orange cloud is on,
# so rate limits and logs see the visitor's address instead of Cloudflare's.
# TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
