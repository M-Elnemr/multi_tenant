{
  "manifest_version": 3,
  "name": "Elmanassa - Facebook connect helper",
  "version": "1.1.0",
  "key": "",
  "description": "One-click Facebook connect for your Elmanassa dashboard: gives your dashboard the Facebook session of this browser when you press Connect.",
  "permissions": ["cookies", "clipboardWrite"],
  "host_permissions": ["https://*.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": ["https://*.elmanassa.shop/*", "https://elmanassa.shop/*", "http://*.localhost/*", "http://localhost/*"]
  },
  "action": { "default_title": "Copy Facebook cookies", "default_popup": "popup.html" }
}
