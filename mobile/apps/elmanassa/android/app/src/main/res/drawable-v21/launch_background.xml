<?xml version="1.0" encoding="utf-8"?>
<!-- Brand gradient shown by Android before Flutter draws the animated splash (no white flash) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1F6A99" android:endColor="#3D9A63" android:angle="315" />
        </shape>
    </item>
</layer-list>
